# MT5 credentials (leave blank if using demo account without login)
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Live
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Optional: Webhook for signal notifications (Slack, Discord, etc.)
WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Telegram bot alerts
# 1. Message @BotFather → /newbot → paste token below
# 2. Start your bot, then run: python -c "from src.telegram_bot import get_chat_id; get_chat_id()"
TELEGRAM_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxYZ
TELEGRAM_CHAT_ID=987654321
TELEGRAM_MIN_SCORE=6

# Auto-execution settings
MIN_AUTO_TRADE_SCORE=7     # minimum signal score (0-10) to place a trade
RISK_PCT_PER_TRADE=1.0     # % of account balance to risk per trade
MAX_OPEN_TRADES=5          # max concurrent Dante-managed trades
MAX_SPREAD_PIPS=3.0        # skip entry if spread exceeds this
MAX_DAILY_LOSS_PCT=5.0     # halt trading for the day if loss hits this %
BREAKEVEN_AT_TP1=true      # move SL to entry price when TP1 is hit
